# 拾词本地/云端配置模板。
# 复制为 .env 后填写真实值；.env 已被 .gitignore 排除，绝不要提交。

# --- DeepSeek（实例级共享，不进入 SQLite，也不进入数据库备份）---
# 管理员也可在设置页保存，值写入 data/config/settings.json（已被 Git 忽略）。
# 环境变量优先生效。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- 数据目录 ---
# 留空则使用项目根目录下的 data/
# VOCAB_DATA_DIR=

# --- OCR（本地能力；云端部署应设为 false）---
# false 时应用启动不再加载 PaddleOCR，OCR 相关接口返回明确错误。
VOCAB_ENABLE_OCR=true

# --- 会话与 Cookie ---
# 生产 HTTPS 环境必须为 true；本地 http://127.0.0.1 开发需为 false，否则无法登录。
VOCAB_COOKIE_SECURE=false
# 会话有效期（天）；这是绝对上限，任何活动都不会延长它。
VOCAB_SESSION_DAYS=30
# 闲置超时（天）：超过这么久没有任何请求，会话立即失效（401）。
# 0 = 关闭闲置检查，只保留上面的绝对有效期。
VOCAB_SESSION_IDLE_DAYS=7
# 初始管理员用户名（仅 CLI/migration 使用）
VOCAB_BOOTSTRAP_USERNAME=admin
