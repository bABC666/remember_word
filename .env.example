# 拾词本地/云端配置模板。
# 复制为 .env 后填写真实值；.env 已被 .gitignore 排除，绝不要提交。

# --- DeepSeek（实例级共享，不进入 SQLite，也不进入数据库备份）---
# 管理员也可在设置页保存，值写入 data/config/settings.json（已被 Git 忽略）。
# 环境变量优先生效。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- 数据目录 ---
# 留空则使用项目根目录下的 data/
# VOCAB_DATA_DIR=
# 显式指定数据库文件（Phase 2.8 T17）。用途是**明确选择数据库环境**：留空时数据库为
# <数据目录>/vocab.db；填写后数据库以它为准（uploads/backups/config 等目录仍由上面的
# VOCAB_DATA_DIR 决定）。开发与测试各自指向自己的副本，**绝不要指向生产库
# data/vocab.db**——那样一次试跑就会直接改动真实用户数据。
# 请填绝对路径：相对路径按进程工作目录解析，而服务与 alembic 的工作目录并不相同。
# VOCAB_DATABASE_PATH=

# --- OCR（本地能力；云端部署应设为 false）---
# false 时应用启动不再加载 PaddleOCR，OCR 相关接口返回明确错误。
VOCAB_ENABLE_OCR=true

# --- 会话与 Cookie ---
# 生产 HTTPS 环境必须为 true；本地 http://127.0.0.1 开发需为 false，否则无法登录。
VOCAB_COOKIE_SECURE=false
# 会话有效期（天）；这是绝对上限，任何活动都不会延长它。
VOCAB_SESSION_DAYS=30
# 闲置超时（天）：超过这么久没有任何请求，会话立即失效（401）。
# 0 = 关闭闲置检查，只保留上面的绝对有效期。
VOCAB_SESSION_IDLE_DAYS=7
# 每个账号最多同时存活的登录会话数（Phase 2.8 G5）。
# 超限时新登录仍然成功：先清理已失效的会话行，再撤销“最久未活动”的那条
# （按 COALESCE(last_seen_at, created_at) 最早；刚签发的当前会话永不淘汰），
# 并写一条不含任何凭据的 session_evicted 审计事件。
# 0 = 不限制（清理交给启动/CLI 的 prune-sessions）。
VOCAB_MAX_SESSIONS_PER_USER=10
# 初始管理员用户名（仅 CLI/migration 使用）
VOCAB_BOOTSTRAP_USERNAME=admin

# --- 登录防滥用（Phase 2.6-a）---
# 同时在跑的密码校验上限。每次 Argon2id 校验约占 64 MiB 内存，所以这是限制进程内存的旋钮；
# 超过上限的请求立即返回 429（不排队等待）。
VOCAB_LOGIN_MAX_CONCURRENT=8
# 同一客户端地址在窗口内允许的失败登录次数；达到后该地址的登录立即返回 429。
# 0 = 关闭这项检查（只保留上面的并发闸门）。
VOCAB_LOGIN_IP_FAILURES=10
# 失败计数窗口（秒）。窗口滑动过期，成功后该地址的计数清零。
VOCAB_LOGIN_IP_WINDOW_SECONDS=300

# --- 敏感操作二次认证（Phase 2.7-d-c）---
# 同一账号在窗口内允许的密码校验失败次数；达到后该账号的敏感操作（改密码等）
# 立即返回 429。按「用户」计数，与上面的登录限流（按 IP）互相独立。
# 0 = 关闭这项检查。
VOCAB_REAUTH_FAILURES=5
# 二次认证失败计数的窗口（秒）。窗口刻意取短：输错口令或被恶意烧额度后，
# 用户不会长时间无法修改自己的密码。
VOCAB_REAUTH_WINDOW_SECONDS=300

# --- CSRF 同源校验（Phase 2.8 S-2）---
# 写请求（POST/PUT/PATCH/DELETE）必须来自请求所指向的主机：浏览器发送的 Origin
# （缺失时回落 Referer）必须与请求的 Host 同主机同端口。只比较 host:port，不比较
# scheme，因此 Caddy 终止 TLS 不影响判断。GET/HEAD/OPTIONS 一律放行。
# 默认 false：浏览器在非安全方法上总会发送 Origin，因此缺失它只可能是脚本客户端
# 或刻意规避检查。仅当确有无法设置请求头的脚本客户端时才改为 true——它会让所有
# 客户端一起失去这层防护。
VOCAB_CSRF_ALLOW_MISSING_ORIGIN=false
# 额外接受的可信来源（逗号分隔）。仅在「请求 Host 与浏览器地址栏来源不一致」时需要：
# 反向代理改写 Host，或存在第二个入口（例如同时用域名与局域网 IP 访问）。
# 常规部署无需填写：请求自己的 Host 永远被接受。
# VOCAB_CSRF_TRUSTED_ORIGINS=https://vocab.example.com,http://192.168.1.10:8000
