[Unit]
Description=Shici vocabulary app (private staging)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shici
Group=shici
WorkingDirectory=/opt/shici/current
EnvironmentFile=/etc/shici/shici.env
ExecStart=/opt/shici/current/.venv/bin/python -m uvicorn app.main:app --app-dir /opt/shici/current/backend --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
