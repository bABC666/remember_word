# Copy to /etc/shici/shici.env, owned by root and mode 0600.
# This private staging profile is accessed through an SSH tunnel only.
VOCAB_DATA_DIR=/var/lib/shici
VOCAB_DATABASE_PATH=/var/lib/shici/vocab.db
# Set true after installing and verifying the CPU OCR runtime; see deploy/OCR.md.
VOCAB_ENABLE_OCR=false
VOCAB_COOKIE_SECURE=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
